# Copy to .env and edit. .env is gitignored; this file is not, so never put a
# real credential here.
#
# Docker Compose reads .env automatically. For `./mvnw spring-boot:run` with the
# dev profile you can leave them unset entirely: application-dev.properties
# defaults each one to the values below. Without the dev profile all three
# SPRING_DATASOURCE values must be set, which is the deployed case.

# Database, as published by docker-compose.yml.
POSTGRES_USER=clanadmin
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=clan_management
POSTGRES_PORT=5432

# What the application connects with. Setting SPRING_DATASOURCE_URL is also the
# signal the integration tests use to decide a database is available: with it
# set they run, without it they skip.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/clan_management
SPRING_DATASOURCE_USERNAME=clanadmin
SPRING_DATASOURCE_PASSWORD=devpassword

# Log every SQL statement Hibernate issues. Noisy; off by default.
SPRING_JPA_SHOW_SQL=false
